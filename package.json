{
  "name": "code-generator-lib",
  "version": "1.0.3",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "barcode",
    "qrcode",
    "generator",
    "qr",
    "bar",
    "code",
    "svg",
    "base64",
    "zero-dependency",
    "universal",
    "pure"
  ],
  "author": "Twinkal K Raj",
  "license": "ISC",
  "description": "A zero-dependency universal npm library for generating Code 128 Barcodes and QR Codes as SVG strings or Base64 Data URIs.",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}